name: Build
on:
  push:
    branches: [master]
    tags: ['v*']
  pull_request:
permissions:
  contents: read
jobs:
  build:
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        java: [17, 21, 25, 26, 27]
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: ${{ matrix.java }}

      - uses: gradle/actions/setup-gradle@v4

      - name: Build and test
        run: ./gradlew build -PjavaVersion=${{ matrix.java }} --no-daemon

      - name: Verify single executable JAR
        run: |
          mapfile -t jars < <(find target/libs -maxdepth 1 -name "*.jar" ! -name "*-plain.jar" ! -name "*-sources.jar" ! -name "*-javadoc.jar" -type f)
          
          if [ "${#jars[@]}" -ne 1 ]; then
            echo "::error::Expected exactly 1 executable JAR, but found ${#jars[@]}: ${jars[*]}"
            exit 1
          fi
          
          if ! test -s "${jars[0]}"; then
            echo "::error::The JAR file '${jars[0]}' is empty (size is 0)."
            exit 1
          fi
          
          echo "Verified single executable JAR: ${jars[0]}"

      - name: Upload executable JAR
        if: github.event_name == 'push'
        uses: actions/upload-artifact@v4
        with:
          name: application-java-${{ matrix.java }}
          path: |
            target/libs/*.jar
            !target/libs/*-plain.jar
            !target/libs/*-sources.jar
            !target/libs/*-javadoc.jar
          if-no-files-found: error
          retention-days: 14
          compression-level: 0

  publish-source-info:
    needs: build
    if: github.event_name == 'push'
    runs-on: ubuntu-latest
    steps:
      - name: Save source ref and SHA
        env:
          SOURCE_REF: ${{ github.ref }}
          SOURCE_SHA: ${{ github.sha }}
        run: |
          mkdir -p source-info
          printf '%s\n' "$SOURCE_REF" > source-info/ref
          printf '


